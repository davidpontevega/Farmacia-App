# Neon
DATABASE_URL=""

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
CLERK_SECRET_KEY=""
# Firma del endpoint de webhooks (dashboard de Clerk -> Webhooks)
CLERK_WEBHOOK_SIGNING_SECRET=""

# RBAC - email del super administrador inicial, lo usa `npm run db:seed`
SUPER_ADMIN_EMAIL=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Marca del negocio (opcional; por defecto NicFarma)
NEXT_PUBLIC_BRAND_NAME=NicFarma
NEXT_PUBLIC_BRAND_TAGLINE=Botica · Perfumería

# Constancias de pago Yape/Plin (spec 014). Vercel -> Storage -> Blob (privado).
# Sin BLOB_READ_WRITE_TOKEN el botón de foto no aparece.
BLOB_READ_WRITE_TOKEN=""
# Protege /api/cron/purge-proofs; Vercel lo envía como Bearer en el cron.
CRON_SECRET=""
